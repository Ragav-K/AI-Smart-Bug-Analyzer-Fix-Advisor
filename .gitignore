# Python generated files
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Packaging/build output
build/
dist/
*.egg-info/

# Local configuration and secrets
.env
.env.*
!.env.example

# Streamlit/runtime logs
*.log
.streamlit/secrets.toml

# App runtime data
data/*.json
data/chroma_*/
uploads/

# Confirmed fixes learned from resolved submissions. Like saved reports, this
# is per-deployment operational data, not part of the shipped corpus.
gitbugs/learned/

# Large source datasets (~491 MB). The committed knowledge base is
# gitbugs/samples/, regenerated with scripts/build_sample_corpus.py.
gitbugs/*/*_bugs.csv
!gitbugs/samples/

# OS/editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
